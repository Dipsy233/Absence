{
  "name": "@absence/desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "ABSENCE desktop shell — runs the Absence server in-process and shows the UI in a native window.",
  "author": "ABSENCE",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "bundle": "node scripts/bundle-server.mjs",
    "stage": "node scripts/stage-desktop.mjs",
    "icons": "node scripts/make-icons.mjs",
    "pack": "npm run stage && electron-builder --dir",
    "dist": "npm run stage && electron-builder"
  },
  "devDependencies": {
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.2"
  },
  "build": {
    "appId": "com.absence.observer",
    "productName": "Absence",
    "directories": {
      "output": "../../dist/desktop/release",
      "buildResources": "assets"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "assets/**/*",
      "!scripts/**"
    ],
    "extraResources": [
      {
        "from": "scripts/start-server.sh",
        "to": "start-server.sh"
      },
      {
        "from": "../../dist/desktop/build/server.cjs",
        "to": "apps/server-bundle.cjs"
      },
      {
        "from": "../../dist/desktop/build/node_modules",
        "to": "node_modules",
        "filter": ["**/*"]
      },
      {
        "from": "../../dist/web",
        "to": "dist/web",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico",
      "extraResources": [
        {
          "from": "../../native/agentwatch/agentwatch.exe",
          "to": "native/agentwatch/agentwatch.exe"
        }
      ]
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "icon": "assets/icon.png",
      "category": "Development",
      "executableName": "absence",
      "artifactName": "Absence-${version}.${ext}",
      "syncDesktopName": true,
      "extraResources": [
        {
          "from": "../../native/agentwatch-linux/agentwatch-linux",
          "to": "native/agentwatch-linux/agentwatch-linux"
        }
      ]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
