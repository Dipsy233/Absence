{
  "version": 1,
  "note": "Shape-based classification for ACP tool calls whose kind is 'other' or missing. Rules only look at generic field names (command / path / old_string / url …), never at an agent name or product-specific tool title. A new agent therefore needs no code change: if it sends an ACP-shaped call, these rules already cover it.",
  "fields": {
    "command": ["command", "cmd", "script", "shell_command", "commandLine"],
    "path": ["path", "file_path", "filePath", "file", "filename", "target_file", "abs_path"],
    "content": ["content", "contents", "text", "new_string", "newText", "new_str"],
    "oldContent": ["old_string", "oldText", "old_str"],
    "query": ["pattern", "query", "glob", "regex", "search"],
    "url": ["url", "uri", "endpoint"],
    "range": ["offset", "limit", "start_line", "end_line", "startLine", "endLine"]
  },
  "rules": [
    {
      "id": "mcp",
      "kind": "fetch",
      "when": { "namePattern": "^mcp__" },
      "as": "mcp"
    },
    {
      "id": "shell-command",
      "kind": "execute",
      "when": { "anyField": "command" }
    },
    {
      "id": "edit-with-replacement",
      "kind": "edit",
      "when": { "anyField": "oldContent" }
    },
    {
      "id": "write-with-content",
      "kind": "edit",
      "when": { "allFields": ["path", "content"] },
      "as": "write"
    },
    {
      "id": "search-with-query",
      "kind": "search",
      "when": { "anyField": "query" }
    },
    {
      "id": "fetch-with-url",
      "kind": "fetch",
      "when": { "anyField": "url" }
    },
    {
      "id": "read-with-range",
      "kind": "read",
      "when": { "allFields": ["path", "range"] }
    },
    {
      "id": "read-with-path",
      "kind": "read",
      "when": { "allFields": ["path"] }
    },
    {
      "id": "plan-or-task",
      "kind": "think",
      "when": { "namePattern": "^(todo|task|plan|update_plan|write_todos)$" }
    }
  ]
}
