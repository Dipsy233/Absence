{
  "name": "absence",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "ABSENCE / 发呆症 — a real-time visualization observer for AI agents. Pi runs the agent, Absence observes the events, the Stage turns events into something humans can watch.",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @absence/server",
    "dev:web": "npm run dev -w @absence/web",
    "build": "npm run build -w @absence/web",
    "start": "npm run start -w @absence/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:eggs": "tsx scripts/checks/check-eggs.ts",
    "check:classify": "tsx scripts/checks/check-classify.ts",
    "check:codex": "tsx scripts/checks/check-codex.ts",
    "check:execserver": "tsx scripts/checks/check-execserver.ts",
    "check:shellenv": "tsx scripts/checks/check-shellenv.ts",
    "check:codexshell": "tsx scripts/checks/check-codexshell.ts",
    "check:fsdiff": "tsx scripts/checks/check-fsdiff.ts",
    "check:agentwatch": "tsx scripts/checks/check-agentwatch.ts",
    "check:ebpf": "tsx scripts/checks/check-ebpf.ts",
    "check:history": "tsx scripts/checks/check-history.ts",
    "check:capabilities": "tsx scripts/checks/check-capabilities.ts",
    "check:mcp": "tsx scripts/checks/check-mcp-events.ts",
    "check:observer": "tsx scripts/checks/check-observer.ts",
    "check:lifecycle": "tsx scripts/checks/check-lifecycle.ts",
    "check:capability-commands": "tsx scripts/checks/check-capability-commands.ts",
    "probe:mcp": "tsx scripts/dev/probe-mcp.ts",
    "probe:absence-mcp": "tsx scripts/dev/probe-absence-mcp.ts",
    "check:incremental": "tsx scripts/checks/check-incremental.ts",
    "bench:incremental": "tsx scripts/checks/check-incremental-bench.ts",
    "check:offline": "tsx scripts/checks/run-offline.ts",
    "check:report": "tsx scripts/checks/check-report.ts",
    "check:process": "npm run check:eggs && npm run check:classify && npm run check:codex && npm run check:codexshell && npm run check:execserver && npm run check:shellenv && npm run check:fsdiff && npm run --if-present check:agentwatch && npm run --if-present check:ebpf",
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop": "npm --prefix apps/desktop start",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:bundle": "npm --prefix apps/desktop run bundle",
    "desktop:stage": "npm --prefix apps/desktop run stage",
    "desktop:icons": "npm --prefix apps/desktop run icons",
    "desktop:pack": "npm run build && npm --prefix apps/desktop run pack",
    "desktop:dist": "npm run build && npm --prefix apps/desktop run dist",
    "build:agentwatch": "cd native/agentwatch && build.bat"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
