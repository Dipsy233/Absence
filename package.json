{
  "name": "daze",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DAZE / 发呆症 — a real-time visualization observer for AI agents. Pi runs the agent, Daze observes the events, the Stage turns events into something humans can watch.",
  "workspaces": [
    "packages/*",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @daze/server",
    "dev:web": "npm run dev -w @daze/web",
    "build": "npm run build -w @daze/web",
    "start": "npm run start -w @daze/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:eggs": "tsx scripts/check-eggs.ts",
    "check:classify": "tsx scripts/check-classify.ts",
    "check:agentwatch": "tsx scripts/check-agentwatch.ts",
    "check:ebpf": "tsx scripts/check-ebpf.ts",
    "check:process": "npm run check:eggs && npm run check:classify && npm run check:agentwatch && npm run check:ebpf",
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop": "npm --prefix apps/desktop start",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "build:agentwatch": "cd native/agentwatch && build.bat"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
