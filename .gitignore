node_modules/
.DS_Store
*.log
.env
.env.local
.vite/

# Playwright CLI debug dumps (timestamped page/console snapshots from a manual
# session, not test fixtures). The real Playwright config and specs, if any,
# live elsewhere.
.playwright-cli/

# Local editor / agent-tool state (VS Code workspace settings, plan scratch
# files). Per-machine, never part of a build.
.vscode/
.zcode/

# All build output lives under the repo-root dist/ (git ignored):
#   dist/web                    the built UI (apps/web/vite.config.ts)
#   dist/desktop/build          the server bundle + staged prod node_modules
#   dist/desktop/release        the packaged app (portable folder / installer)
# Regenerated by `npm run build` and the desktop staging script.
dist/

# The app icons under apps/desktop/assets are generated by
# apps/desktop/scripts/make-icons.mjs but committed, so a fresh clone can build
# without running that step first.

# eBPF build artefacts (native/agentwatch-linux). The binary is committed; the
# generated header and objects are rebuilt by build.sh.
native/agentwatch-linux/vmlinux.h
native/agentwatch-linux/*.bpf.o
native/agentwatch-linux/*.skel.h

# user-managed data (created at runtime, seeded by the server)
apps/server/src/process/avatar-skins/
apps/server/src/process/egg-filters/
apps/server/src/process/sound-sets/

# esbuild scratch dir used by the launcher (kept out of the scanned system temp)
.tmp-build/

# Release notes generated from commit subjects by `npm run release:notes` (the
# release workflow writes this in CI; the committed notes live in docs/).
release-notes.md
